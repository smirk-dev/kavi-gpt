,{"stream_name":"stdout","time":21267.321647205,"data":"Tis one, sir.\n"}
,{"stream_name":"stdout","time":21267.321663084,"data":"\n"}
,{"stream_name":"stdout","time":21267.321668615,"data":"SECOND GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321672971,"data":"What’s the matter?\n"}
,{"stream_name":"stdout","time":21267.32167766,"data":"\n"}
,{"stream_name":"stdout","time":21267.321681561,"data":"THIRD GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321685597,"data":"My name is Wingfield.\n"}
,{"stream_name":"stdout","time":21267.321689594,"data":"\n"}
,{"stream_name":"stdout","time":21267.321693489,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321697506,"data":"I can tell you, sir, how many knaves are here?\n"}
,{"stream_name":"stdout","time":21267.32170157,"data":"\n"}
,{"stream_name":"stdout","time":21267.32170551,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321709505,"data":"Ay, sir.\n"}
,{"stream_name":"stdout","time":21267.321713642,"data":"\n"}
,{"stream_name":"stdout","time":21267.321717759,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321721884,"data":"That, sir.\n"}
,{"stream_name":"stdout","time":21267.321726474,"data":"\n"}
,{"stream_name":"stdout","time":21267.32173071,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321734962,"data":"He was never so far gone.\n"}
,{"stream_name":"stdout","time":21267.321740322,"data":"\n"}
,{"stream_name":"stdout","time":21267.321744835,"data":"THIRD GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321749194,"data":"’Twas well done.\n"}
,{"stream_name":"stdout","time":21267.32175391,"data":"\n"}
,{"stream_name":"stdout","time":21267.321758814,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321763705,"data":"And that’s now come.\n"}
,{"stream_name":"stdout","time":21267.321778922,"data":"\n"}
,{"stream_name":"stdout","time":21267.32178269,"data":"THIRD GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321787222,"data":"’Tis very well.\n"}
,{"stream_name":"stdout","time":21267.321792124,"data":"\n"}
,{"stream_name":"stdout","time":21267.32179548,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.32179909,"data":"I would a thousand times had never yet a look. But here he comes.\n"}
,{"stream_name":"stdout","time":21267.321803006,"data":"\n"}
,{"stream_name":"stdout","time":21267.32180667,"data":"Enter Servant.\n"}
,{"stream_name":"stdout","time":21267.32181004,"data":"\n"}
,{"stream_name":"stdout","time":21267.321813164,"data":"SERVANT.\n"}
,{"stream_name":"stdout","time":21267.321816339,"data":"Captain Macbeth, to whom is that?\n"}
,{"stream_name":"stdout","time":21267.321819524,"data":"\n"}
,{"stream_name":"stdout","time":21267.321822681,"data":"FIRST GENTLEMAN.\n"}
,{"stream_name":"stdout","time":21267.321825822,"data":"Sir, that’s all one.\n"}
,{"stream_name":"stdout","time":21267.321829086,"data":"\n"}
,{"stream_name":"stdout","time":21267.321832085,"data":"SERVANT.\n"}
,{"stream_name":"stdout","time":21267.321835225,"data":"I\n"}
