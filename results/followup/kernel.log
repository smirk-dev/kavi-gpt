,{"stream_name":"stdout","time":3551.599444494,"data":"That has no eyes.\n"}
,{"stream_name":"stdout","time":3551.59944763,"data":"\n"}
,{"stream_name":"stdout","time":3551.59945072,"data":"ARVIRAGUS.\n"}
