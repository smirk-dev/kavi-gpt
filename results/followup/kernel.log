,{"stream_name":"stdout","time":3551.596356752,"data":"WIDEN.\n"}
,{"stream_name":"stdout","time":3551.596365873,"data":"Here is my name and lady\n"}
,{"stream_name":"stdout","time":3551.596369444,"data":"By the best and comfort of my life\n"}
,{"stream_name":"stdout","time":3551.596372697,"data":"I will not take my greetings; but my part\n"}
,{"stream_name":"stdout","time":3551.596380809,"data":"Is this the preparation of my friend,\n"}
,{"stream_name":"stdout","time":3551.59638479,"data":"The Queen’s for ’tis to come, and I do supple\n"}
,{"stream_name":"stdout","time":3551.596389498,"data":"To be a woman.\n"}
,{"stream_name":"stdout","time":3551.596393405,"data":"\n"}
,{"stream_name":"stdout","time":3551.596397297,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.59640104,"data":"You were invention,\n"}
,{"stream_name":"stdout","time":3551.596405432,"data":"Being much more perpetual. I am sorry\n"}
,{"stream_name":"stdout","time":3551.596416053,"data":"My business being, sir; yet the issue\n"}
,{"stream_name":"stdout","time":3551.596419508,"data":"Will not be revenged.\n"}
,{"stream_name":"stdout","time":3551.596423707,"data":"\n"}
,{"stream_name":"stdout","time":3551.596426824,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596429945,"data":"You’ll be sworn.\n"}
,{"stream_name":"stdout","time":3551.596433243,"data":"\n"}
,{"stream_name":"stdout","time":3551.59643625,"data":" [_Exit._]\n"}
,{"stream_name":"stdout","time":3551.596439418,"data":"\n"}
,{"stream_name":"stdout","time":3551.596442569,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596445772,"data":"I cannot be.\n"}
,{"stream_name":"stdout","time":3551.596448993,"data":"\n"}
,{"stream_name":"stdout","time":3551.596452076,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596455197,"data":"I am sorry for ’t.\n"}
,{"stream_name":"stdout","time":3551.596458324,"data":"I have been sick, but I would\n"}
,{"stream_name":"stdout","time":3551.596463068,"data":"If you were so long too well as you have.\n"}
,{"stream_name":"stdout","time":3551.596484202,"data":"There is my father’s eyes, though I have found it,\n"}
,{"stream_name":"stdout","time":3551.596488402,"data":"Not such as I have heard of you. If I come\n"}
,{"stream_name":"stdout","time":3551.596492312,"data":"To see the issue of a lady and my honour\n"}
,{"stream_name":"stdout","time":3551.59649621,"data":"Is in my best opinion, my life, I\n"}
,{"stream_name":"stdout","time":3551.596499928,"data":"Have my friend with that most worthy thanks\n"}
,{"stream_name":"stdout","time":3551.596503372,"data":"I’ th’ world, with my wife.\n"}
,{"stream_name":"stdout","time":3551.596506588,"data":"\n"}
,{"stream_name":"stdout","time":3551.59650959,"data":"MIRANDA.\n"}
,{"stream_name":"stdout","time":3551.59651273,"data":"I wish it.\n"}
,{"stream_name":"stdout","time":3551.596515895,"data":"\n"}
,{"stream_name":"stdout","time":3551.596518895,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596522122,"data":"How do you knew it?\n"}
,{"stream_name":"stdout","time":3551.596525268,"data":"\n"}
,{"stream_name":"stdout","time":3551.596528262,"data":"MIRANDA.\n"}
,{"stream_name":"stdout","time":3551.596531451,"data":"I am not an experbition of the gods.\n"}
,{"stream_name":"stdout","time":3551.596534635,"data":"\n"}
,{"stream_name":"stdout","time":3551.596537639,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596540738,"data":"But do not know him not.\n"}
,{"stream_name":"stdout","time":3551.596543894,"data":"\n"}
,{"stream_name":"stdout","time":3551.596546913,"data":"MIRANDA.\n"}
,{"stream_name":"stdout","time":3551.596550005,"data":"For’t is madness.\n"}
,{"stream_name":"stdout","time":3551.596553278,"data":"\n"}
,{"stream_name":"stdout","time":3551.596561293,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596564927,"data":"So fare you well.\n"}
,{"stream_name":"stdout","time":3551.59657954,"data":"\n"}
,{"stream_name":"stdout","time":3551.59658803,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596592082,"data":"I have spoken and honest, for I have heard\n"}
,{"stream_name":"stdout","time":3551.596595983,"data":"A deed of man, and had been by’t\n"}
,{"stream_name":"stdout","time":3551.596599396,"data":"To make him speak.\n"}
,{"stream_name":"stdout","time":3551.596602578,"data":"\n"}
,{"stream_name":"stdout","time":3551.596605544,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.596608585,"data":"I am sorry\n"}
,{"stream_name":"stdout","time":3551.596611684,"data":"To speak at it, or no more.\n"}
,{"stream_name":"stdout","time":3551.596614814,"data":"\n"}
,{"stream_name":"stdout","time":3551.596617943,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.59662106,"data":"I am very noble:\n"}
