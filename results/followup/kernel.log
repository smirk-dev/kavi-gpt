,{"stream_name":"stdout","time":3551.599472324,"data":"PROSPERO.\n"}
,{"stream_name":"stdout","time":3551.599475427,"data":"No more,\n"}
,{"stream_name":"stdout","time":3551.599478652,"data":"I never saw you, but I would not have him\n"}
,{"stream_name":"stdout","time":3551.599487622,"data":"To be as they saw. And here I did not be.\n"}
